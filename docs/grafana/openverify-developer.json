    {
      "id": 15,
      "type": "timeseries",
      "title": "Verify RTT (mean)",
      "description": "open_verify wall time after admission. success/failure only \u2014 FIFO rejects are on Queue admissions. Failure mean often \u2248 VERIFY_TIMEOUT when timeouts dominate.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(xrootd_openverify_verify_rtt_seconds_sum{result=\"success\",xrootd_instance=~\"$instance\"}[$__rate_interval])) / clamp_min(sum(rate(xrootd_openverify_verify_rtt_seconds_count{result=\"success\",xrootd_instance=~\"$instance\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "success",
