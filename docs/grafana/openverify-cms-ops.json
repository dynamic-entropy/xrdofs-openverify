          "expr": "sum(rate(xrootd_openverify_cmsd_stall_budget_exhausted_total{xrootd_instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "budget exhausted",
          "datasource": {
            "type": "prometheus",
