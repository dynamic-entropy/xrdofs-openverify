      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (host) (rate(xrootd_openverify_verify_failures_total{xrootd_instance=~\"$instance\",host=~\"$site\",reason=~\"$reason\"}[$__rate_interval]))",
          "legendFormat": "{{host}}",
          "datasource": {
            "type": "prometheus",
