      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(xrootd_openverify_redirect_delay_seconds_sum{xrootd_instance=~\"$instance\"}[$__rate_interval])) / clamp_min(sum(rate(xrootd_openverify_redirect_delay_seconds_count{xrootd_instance=~\"$instance\"}[$__rate_interval])), 1e-9)",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
