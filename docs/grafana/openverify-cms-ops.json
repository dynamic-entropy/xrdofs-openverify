    {
      "id": 14,
      "type": "timeseries",
      "title": "Site EWMA health (higher = worse)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, xrootd_openverify_site_ewma_health{xrootd_instance=~\"$instance\",host=~\"$site\"})",
          "legendFormat": "{{host}}:{{port}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "range": true
