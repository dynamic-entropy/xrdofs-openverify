    {
      "id": 22,
      "type": "timeseries",
      "title": "cmsd stalls (lookup delay)",
      "description": "Pre-redirect cmsd SFS_STALL — not attributed to a site. Budget exhausted = XRD_OPENVERIFY_STALL_TIMEOUT.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(xrootd_openverify_cmsd_stalls_total{xrootd_instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "stall events",
          "datasource": {
            "type": "prometheus",
