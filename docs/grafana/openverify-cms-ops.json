    {
      "id": 26,
      "type": "heatmap",
      "title": "OpenVerify redirect delay (histogram)",
      "description": "Distribution of wall time from SFS_REDIRECT until accept/retry (queue wait + verify). Filter with Delay outcome. Buckets: 1ms\u202630s, +Inf. Does not include cmsd stalls.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (rate(xrootd_openverify_redirect_delay_seconds_bucket{xrootd_instance=~\"$instance\",outcome=~\"$delay_outcome\"}[$__rate_interval]))",
          "legendFormat": "{{le}}",
          "format": "heatmap",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "calculate": false,
        "yBucketBound": "auto",
        "yBucketSize": null,
        "rowsFrame": {
          "layout": "auto"
        },
        "color": {
          "mode": "scheme",
          "scheme": "Spectral",
          "fill": "dark-orange",
          "reverse": false,
          "steps": 64,
          "min": null,
          "max": null,
          "exponent": 0.5
        },
        "cellGap": 1,
        "filterValues": {
          "le": 1e-9
        },
        "tooltip": {
          "mode": "single",
          "yHistogram": true
        },
        "legend": {
          "show": true
        },
        "yAxis": {
          "axisPlacement": "left",
          "reverse": false,
          "unit": "s",
          "decimals": 3
        },
        "cellValues": {
          "unit": "ops"
        }
      }
    },
