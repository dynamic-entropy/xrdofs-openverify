[Unit]
Description=XRootD AAA monitor collector (r-stream + xrd.report → Prometheus textfile)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/xrdmon-collector \
  -listen :9930 \
  -out /var/lib/node_exporter/textfile_collector/xrdmon.prom \
  -instance %H \
  -write-interval 15s
Restart=on-failure
RestartSec=5
# Textfile dir is mode 1777 on the canary; no special user required.
AmbientCapabilities=
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
